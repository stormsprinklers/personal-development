# Plaid (Finance tab) — add these to .env / .env.local / Vercel
PLAID_CLIENT_ID=
PLAID_SECRET_KEY=
# Must match the key environment: sandbox | development | production
PLAID_ENV=sandbox
# Optional. Must be a valid https URL, e.g. https://your-app.vercel.app/api/finance/plaid/webhook
PLAID_WEBHOOK_URL=
