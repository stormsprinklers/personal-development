generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  displayName        String
  accountabilityCode String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  appData              AppDataStore?
  linksInitiated       AccountabilityLink[] @relation("LinkInitiator")
  linksFrom            AccountabilityLink[] @relation("LinkFrom")
  linksTo              AccountabilityLink[] @relation("LinkTo")
  journalVoiceMemos    JournalVoiceMemo[]
  accountabilityInvitesCreated AccountabilityInvite[] @relation("InviteCreator")
  accountabilityInvitesRedeemed AccountabilityInvite[] @relation("InviteUsedBy")
  pushSubscriptions    PushSubscription[]
  pushDeliveryLogs     PushDeliveryLog[]
  financePlaidItems    FinancePlaidItem[]
  financeAccounts      FinanceAccount[]
  financeCategories    FinanceCategory[]
  financeMerchants     FinanceMerchant[]
  financeMerchantRules FinanceMerchantRule[]
  financeTransactions  FinanceTransaction[]
}

/** Web Push subscription for a device (iOS home-screen PWA or other browsers). */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** Prevents duplicate push sends for the same user/type/day. */
model PushDeliveryLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  dateKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dateKey])
  @@index([userId])
}

/** Full app snapshot (matches client AppData JSON). One row per user. */
model AppDataStore {
  userId    String   @id
  payload   Json
  legacySyncKey String? @unique
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccountabilityLinkStatus {
  pending
  active
  rejected
  revoked
}

model AccountabilityLink {
  id              String                   @id @default(cuid())
  fromUserId      String
  toUserId        String
  status          AccountabilityLinkStatus @default(pending)
  /** fromUser shares progress with toUser */
  fromShares      Boolean                  @default(false)
  /** toUser shares progress with fromUser */
  toShares        Boolean                  @default(false)
  initiatedByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  fromUser      User @relation("LinkFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User @relation("LinkTo", fields: [toUserId], references: [id], onDelete: Cascade)
  initiatedBy   User @relation("LinkInitiator", fields: [initiatedByUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

/** Legacy rows from pre-auth cloud sync (syncKey primary key). Migrated on register. */
model LegacyAppDataStore {
  syncKey   String   @id
  payload   Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/** Private voice memo audio stored in Vercel Blob; transcript lives in AppData journalEntries. */
model JournalVoiceMemo {
  id             String   @id @default(cuid())
  userId         String
  journalEntryId String?
  blobUrl        String
  blobPathname   String
  recordedAt     DateTime @default(now())
  expiresAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@index([journalEntryId])
}

/** One-time invite link for a new user to register and auto-link as an accountability partner. */
model AccountabilityInvite {
  id            String    @id @default(cuid())
  inviterUserId String
  fromShares    Boolean
  toShares      Boolean
  usedAt        DateTime?
  usedByUserId  String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  inviter User  @relation("InviteCreator", fields: [inviterUserId], references: [id], onDelete: Cascade)
  usedBy  User? @relation("InviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([inviterUserId])
  @@index([expiresAt])
  @@index([usedAt])
}

enum FinanceFlowType {
  expense
  income
  transfer
  cc_payment
  other
}

enum FinanceCategoryKind {
  expense
  income
  transfer
  system
}

enum FinanceReviewStatus {
  needs_review
  reviewed
}

enum FinancePlaidItemStatus {
  active
  needs_reauth
  disconnected
  error
}

/** Linked Plaid Item (institution connection) for a user. */
model FinancePlaidItem {
  id              String                 @id @default(cuid())
  userId          String
  itemId          String                 @unique
  accessToken     String
  institutionId   String?
  institutionName String?
  cursor          String?
  status          FinancePlaidItemStatus @default(active)
  lastSyncedAt    DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts FinanceAccount[]

  @@index([userId])
}

model FinanceAccount {
  id              String   @id @default(cuid())
  userId          String
  plaidItemId     String
  plaidAccountId  String   @unique
  name            String
  officialName    String?
  mask            String?
  type            String
  subtype         String?
  isoCurrencyCode String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem    FinancePlaidItem     @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@index([userId])
  @@index([plaidItemId])
}

model FinanceCategory {
  id        String              @id @default(cuid())
  userId    String
  name      String
  kind      FinanceCategoryKind @default(expense)
  isSystem  Boolean             @default(false)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  rules        FinanceMerchantRule[]

  @@unique([userId, name])
  @@index([userId])
}

model FinanceMerchant {
  id          String   @id @default(cuid())
  userId      String
  key         String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  rule         FinanceMerchantRule?

  @@unique([userId, key])
  @@index([userId])
}

model FinanceMerchantRule {
  id         String           @id @default(cuid())
  userId     String
  merchantId String           @unique
  categoryId String
  flowType   FinanceFlowType?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant FinanceMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
}

model FinanceTransaction {
  id                 String              @id @default(cuid())
  userId             String
  accountId          String
  merchantId         String?
  categoryId         String?
  plaidTransactionId String              @unique
  date               DateTime            @db.Date
  authorizedDate     DateTime?           @db.Date
  name               String
  merchantName       String?
  amount             Decimal             @db.Decimal(14, 2)
  isoCurrencyCode    String              @default("USD")
  pending            Boolean             @default(false)
  flowType           FinanceFlowType     @default(expense)
  reviewStatus       FinanceReviewStatus @default(needs_review)
  plaidPfcPrimary    String?
  plaidPfcDetailed   String?
  plaidPfcConfidence String?
  transferId         String?
  paymentChannel     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  merchant FinanceMerchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, merchantId])
  @@index([userId, categoryId])
  @@index([userId, reviewStatus])
  @@index([userId, flowType])
  @@index([accountId])
}
